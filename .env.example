# Example environment for AnemoneReact.
# Copy to apps/mobile/.env for local development. No secrets are required to build;
# these are optional conveniences for development.

# Optional: pre-fill a Jellyfin server URL in dev builds.
EXPO_PUBLIC_DEFAULT_SERVER_URL=

# Optional: default client name reported to the Jellyfin server.
EXPO_PUBLIC_CLIENT_NAME=Anemone
