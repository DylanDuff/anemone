{
  "name": "anemone-react",
  "version": "0.0.0",
  "description": "A cross-platform (iOS, Android, Android TV, tvOS) Jellyfin client, ported from Swiftfin/Anemone.",
  "license": "MPL-2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "core:test": "pnpm --filter @anemone/core test",
    "core:typecheck": "pnpm --filter @anemone/core typecheck",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "mobile": "pnpm --filter @anemone/mobile start"
  }
}
